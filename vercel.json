{
  "services": {
    "frontend": {
      "root": "static/"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://aco-maps.onrender.com/api/$1"
    },
    {
      "source": "/static/(.*)",
      "destination": "/$1"
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ]
}
